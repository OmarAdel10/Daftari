{
  "name": "daftari-realtime",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Realtime Cloudflare Worker. Requires globally installed wrangler@4.157.0 (see DEVELOPMENT_ENVIRONMENT.md).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "hono": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^5.3.0",
    "vitest": "^3.2.0"
  }
}
